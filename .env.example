NODE_ENV=production
PORT=3000
APP_URL=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=perficient-zone-billing-public
SUPABASE_PRIVATE_BUCKET=perficient-zone-billing-private
