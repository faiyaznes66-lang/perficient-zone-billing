# 64 hex chars (32 bytes); used to encrypt ASP credentials at rest
EINVOICE_CREDENTIALS_ENCRYPTION_KEY=

# Complyance ISV workspace API keys (server-side only; never put these in browser code)
COMPLYANCE_SANDBOX_API_KEY=
COMPLYANCE_PRODUCTION_API_KEY=

# HMAC signing secrets copied from separate Complyance sandbox/production webhooks
COMPLYANCE_WEBHOOK_SECRET_SANDBOX=
COMPLYANCE_WEBHOOK_SECRET_PRODUCTION=
